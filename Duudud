-- สลับเปลี่ยนรายชื่อผู้เล่นเมื่อกดปุ่มเลือก
local playerIndex = 1
SelectBtn.MouseButton1Click:Connect(function()
    local allPlayers = {}
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then
            table.insert(allPlayers, p)
        end
    end

    if #allPlayers == 0 then
        SelectBtn.Text = "ไม่มีผู้เล่นอื่น"
        Config.SelectedPlayer = nil
        return
    end

    playerIndex = playerIndex + 1
    if playerIndex > #allPlayers then playerIndex = 1 end

    Config.SelectedPlayer = allPlayers[playerIndex]
    SelectBtn.Text = Config.SelectedPlayer.DisplayName
end)

